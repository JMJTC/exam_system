@startuml
actor 用户
participant "前端页面" as Frontend
participant "SysUserController" as Controller
participant "SysUserService" as Service
participant "SysUserMapper" as Mapper
participant "数据库" as DB

用户 -> Frontend: 输入用户名和密码并提交
Frontend -> Controller: POST /sysUser/login
activate Controller
Controller -> Service: login(userLoginDTO)
activate Service
Service -> Mapper: selectOne(wrapper)
activate Mapper
Mapper -> DB: 查询用户信息
activate DB
DB --> Mapper: 返回查询结果
deactivate DB
Mapper --> Service: 返回用户信息
deactivate Mapper
alt 用户信息为空
    Service -> Service: 抛出CustomException("请检查用户名密码是否正确")
    Service --> Controller: 异常信息
    Controller --> Frontend: 返回错误响应
    deactivate Controller
    deactivate Service
else 用户信息不为空
    Service -> Service: 验证密码和用户状态
    alt 密码或状态验证失败
        Service -> Service: 抛出CustomException("请检查用户名密码是否正确" 或 "当前用户已经被禁用")
        Service --> Controller: 异常信息
        Controller --> Frontend: 返回错误响应
        deactivate Controller
        deactivate Service
    else 验证成功
        Service -> Service: 生成token和菜单
        Service --> Controller: 返回登录信息
        deactivate Service
        Controller --> Frontend: 返回成功响应和登录信息
        deactivate Controller


@enduml