@startuml
start
:进入系统;
if (是否已有账号?) then (是)
    :输入用户名和密码;
    :点击登录按钮;
    if (登录验证是否成功?) then (是)
        :登录成功;
        if (用户角色是管理员?) then (是)
            :进入管理员界面;
        else if (用户角色是教师?) then (是)
            :进入教师界面;
        else (学生)
            :进入学生界面;
        endif
    else (否)
        :显示登录失败提示;
        :返回登录页面重新输入;
    endif
else (否)
    :点击注册按钮;
    :填写注册信息;
    :点击提交注册;
    if (注册信息是否合法?) then (是)
        :注册成功;
        :自动跳转登录页面;
        :输入用户名和密码;
        :点击登录按钮;
        if (登录验证是否成功?) then (是)
            :登录成功;
            if (用户角色是管理员?) then (是)
                :进入管理员界面;
            else if (用户角色是教师?) then (是)
                :进入教师界面;
            else (学生)
                :进入学生界面;
            endif
        else (否)
            :显示登录失败提示;
            :返回登录页面重新输入;
        endif
    else (否)
        :显示注册信息错误提示;
        :返回注册页面重新填写;
    endif
endif
stop
@enduml